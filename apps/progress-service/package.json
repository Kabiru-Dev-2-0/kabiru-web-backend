{
  "name": "@progress-service/progress-service",
  "private": true,
  "scripts": {
    "start:dev": "bun run prisma:generate && nest start --watch",
    "build": "bun run prisma:generate && nest build",
    "start:prod": "bun run dist/main.js",
    "prisma:generate": "bun --env-file=../../.env prisma generate",
    "db:seed": "bun run prisma:generate && bun --env-file=../../.env prisma migrate deploy && bun --env-file=../../.env prisma/seed.ts",
    "prisma:seed": "bun run prisma:generate && bun --env-file=../../.env prisma/seed.ts",
    "prisma:db:seed": "bun run prisma:generate && bun --env-file=../../.env prisma db seed",
    "prisma:migrate": "bun --env-file=../../.env prisma migrate dev",
    "prisma:deploy": "bun --env-file=../../.env prisma migrate deploy",
    "prisma:status": "bun --env-file=../../.env prisma migrate status",
    "prisma:studio": "bun --env-file=../../.env prisma studio"
  },
  "dependencies": {
    "@kabiru/contracts": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/microservices": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "^6.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/node": "^22.0.0",
    "prisma": "^6.4.0",
    "typescript": "^5.7.0"
  }
}
